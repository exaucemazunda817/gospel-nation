DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Espace admin (/admin) — mot de passe unique partagé (séparé de Clerk).
SESSION_SECRET="generate-a-random-64-char-hex-string"
ADMIN_PASSWORD="change-me"

# Clerk — comptes visiteurs ouverts (connexion, plan de lecture synchronisé).
# À récupérer dans le dashboard Clerk (clerk.com) après création d'une
# application dédiée à gospel-nation (ne pas réutiliser celle de
# gestion-scolaire, qui est en mode Organizations multi-écoles).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# URL publique du site (sans slash final) — indispensable pour les aperçus
# de partage WhatsApp/Facebook. Type "Configuration" sur Vercel, jamais "Secrète".
NEXT_PUBLIC_SITE_URL="https://gospelnation.example"

# Photos des membres (Vercel Blob). Créer un store Blob dans Vercel > Storage,
# puis copier son jeton ici (local) ; sur Vercel il est ajouté automatiquement.
BLOB_READ_WRITE_TOKEN=""
