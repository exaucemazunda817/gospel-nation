  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "gospel-nation.vercel.app" }],
